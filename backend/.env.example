# All of these are optional. Without them, LeadPilot runs fully in mock mode
# (deterministic extraction, local file logging, composed-but-unsent Slack
# message) so the app works end to end with zero setup.

# Gemini API key for real lead extraction + reply drafting
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Google Sheets logging (service account, not OAuth)
# GOOGLE_SERVICE_ACCOUNT_JSON: paste the ENTIRE contents of the downloaded
# service-account key file as a single-line JSON string, e.g.
#   GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}
# (On Render this is required - there's no file on disk to point a path at.
# A local file path also works for local dev only, e.g. ./keys/sa.json)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Leads!A:F

# Slack incoming webhook
SLACK_WEBHOOK_URL=

# CORS - comma separated origins, or * for all
ALLOWED_ORIGINS=*
